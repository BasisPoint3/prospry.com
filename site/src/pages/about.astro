---
import Layout from '../layouts/Layout.astro';

const values = [
	{
		title: 'Craft',
		desc: 'We build things the right way, not the fast way. Good enough isn\'t good enough — the quality of our work is a statement about how much we respect our clients and ourselves.',
	},
	{
		title: 'Clarity',
		desc: 'We strip away what doesn\'t belong. Clean systems, minimal data, honest reporting. Confusion is expensive. Clarity is a competitive advantage.',
	},
	{
		title: 'Speak the truth in love',
		desc: 'We tell you what you need to hear, not just what you want to hear — with warmth, not ego. Honesty without care is just bluntness.',
	},
	{
		title: 'Sweat the details',
		desc: 'Small problems don\'t stay small. We pay attention to what others overlook, because we know it compounds over time.',
	},
	{
		title: 'Raving fans',
		desc: 'Good work isn\'t enough. We want clients who can\'t help but tell others about us — that means making people feel seen, heard, and genuinely cared for.',
	},
];
---

<Layout
	title="About — Prospry"
	description="Prospry is built by Jared Cave, who spent five years building clean, high-craft systems inside a real business — and started Prospry to bring that same discipline to AI."
>
	<main id="top">
		<section class="hero">
			<div class="wrap hero-inner">
				<p class="eyebrow">About Prospry</p>
				<h1>A quiet life of quality, applied to AI.</h1>
				<p class="lede">
					Prospry exists to partner with ambitious business owners —
					simplifying operations, sharpening systems, and building the
					kind of foundation that grows stronger as the business does,
					with the care and craft it deserves.
				</p>
			</div>
		</section>

		<section class="founder">
			<div class="wrap founder-inner">
				<h2>Who's behind it</h2>
				<p>
					Jared spent five years living inside a company's Salesforce
					org — architecture, automation, data model, deployments, all
					of it. He owns the full sandbox promotion path end to end,
					with no separate QA function, because he'd rather catch a
					problem early than clean one up later.
				</p>
				<p>
					That work taught him a blunt lesson: most businesses don't
					have a technology problem, they have a clarity problem. More
					fields, more steps, more tools rarely means more control —
					usually it means less. The businesses that win are the ones
					that strip things back, build with intention, and never
					treat a small detail as too small to matter.
				</p>
				<p>
					Prospry is that same discipline, applied to AI. Jared started
					it to be the guide he wishes more business owners had —
					someone who tells you plainly what's actually worth doing
					with AI, and then does the work of building it, quietly, in
					the background.
				</p>
			</div>
		</section>

		<section class="values">
			<div class="wrap">
				<h2>What we hold to</h2>
				<p class="section-lede">The standard behind every engagement, whether it's a single call or an ongoing partnership.</p>
				<div class="value-grid">
					{values.map((v) => (
						<div class="value-card">
							<h3>{v.title}</h3>
							<p>{v.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="cta">
			<div class="wrap cta-inner">
				<h2>Let's talk about your business.</h2>
				<p>
					No pitch deck, no pressure — just a plain conversation about
					where AI actually fits, and where it doesn't.
				</p>
				<a class="btn btn-primary" href="mailto:hello@prospry.com">Email hello@prospry.com</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		padding: 96px 0 72px;
		background: radial-gradient(circle at 20% 0%, rgba(0, 0, 0, 0.035), transparent 55%);
	}

	.hero-inner {
		max-width: 720px;
	}

	.hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.14;
		margin-bottom: 22px;
	}

	.lede {
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 600px;
	}

	section h2 {
		font-size: 1.8rem;
	}

	.section-lede {
		color: var(--text-muted);
		margin-top: 10px;
		font-size: 1rem;
	}

	.founder {
		padding: 8px 0 80px;
	}

	.founder-inner {
		max-width: 700px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.founder-inner p {
		color: var(--text-muted);
		font-size: 1rem;
	}

	.values {
		padding: 80px 0 96px;
		background: var(--bg-alt);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.value-grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.value-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 26px 28px;
	}

	.value-card h3 {
		font-size: 1.1rem;
		margin-bottom: 10px;
	}

	.value-card p {
		color: var(--text-muted);
		font-size: 0.94rem;
	}

	.cta {
		padding: 96px 0;
		text-align: center;
	}

	.cta-inner {
		max-width: 620px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}

	.cta h2 {
		font-size: 2rem;
	}

	.cta p {
		color: var(--text-muted);
	}

	@media (max-width: 860px) {
		.value-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
