---
import Layout from '../../layouts/Layout.astro';
import { caseStudies } from '../../data/case-studies';

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props;
---

<Layout
	title={`${study.title} — Prospry`}
	description={study.summary}
>
	<main id="top">
		<section class="hero">
			<div class="wrap hero-inner">
				<a class="back-link" href="/our-work">← Our work</a>
				<div class="hero-tags">
					<span class="industry-tag">{study.industry}</span>
					<span class="card-tag">{study.tag}</span>
				</div>
				<h1>{study.title}</h1>
				<p class="metric">{study.metric}</p>
			</div>
		</section>

		<section class="body">
			<div class="wrap body-inner">
				<div class="block">
					<h2>The problem</h2>
					<p>{study.problem}</p>
				</div>

				<div class="block">
					<h2>What we built</h2>
					<ul>
						{study.whatWasBuilt.map((item) => <li>{item}</li>)}
					</ul>
				</div>

				<div class="block">
					<h2>Results</h2>
					<ul>
						{study.results.map((item) => <li>{item}</li>)}
					</ul>
				</div>

				{study.quote && (
					<blockquote>
						<p>{study.quote}</p>
						<cite>{study.attribution}</cite>
					</blockquote>
				)}
			</div>
		</section>

		<section class="cta">
			<div class="wrap cta-inner">
				<h2>Want results like these?</h2>
				<p>
					Book a call and let's talk about what we'd build for your
					business.
				</p>
				<a class="btn btn-primary" href="mailto:hello@prospry.com">Book a call</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		padding: 64px 0 48px;
		background: radial-gradient(circle at 20% 0%, rgba(0, 0, 0, 0.035), transparent 55%);
	}

	.hero-inner {
		max-width: 780px;
	}

	.back-link {
		display: inline-block;
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 24px;
	}

	.back-link:hover {
		color: var(--text);
	}

	.hero-tags {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 16px;
	}

	.industry-tag {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 4px 12px;
	}

	.card-tag {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-strong);
	}

	.hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.14;
		margin-bottom: 16px;
	}

	.metric {
		font-weight: 700;
		color: var(--accent-strong);
		font-size: 1.15rem;
	}

	.body {
		padding: 40px 0 88px;
	}

	.body-inner {
		max-width: 780px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.block h2 {
		font-size: 1.3rem;
		margin-bottom: 14px;
	}

	.block p {
		color: var(--text-muted);
		font-size: 1rem;
	}

	.block ul {
		margin: 0;
		padding-left: 20px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.block li {
		color: var(--text-muted);
		font-size: 1rem;
	}

	blockquote {
		margin: 0;
		padding: 22px 26px;
		border-left: 3px solid var(--accent-strong);
		background: var(--bg-alt);
		border-radius: 0 var(--radius) var(--radius) 0;
	}

	blockquote p {
		color: var(--text);
		font-size: 1.05rem;
		font-style: italic;
		margin-bottom: 8px;
	}

	blockquote cite {
		font-size: 0.9rem;
		font-style: normal;
		color: var(--text-muted);
	}

	.cta {
		padding: 88px 0;
		text-align: center;
		background: var(--bg-alt);
		border-top: 1px solid var(--border);
	}

	.cta-inner {
		max-width: 600px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.cta h2 {
		font-size: 1.8rem;
	}

	.cta p {
		color: var(--text-muted);
	}
</style>
