---
import Layout from '../../layouts/Layout.astro';
import { caseStudies } from '../../data/case-studies';
---

<Layout
	title="Our Work — Prospry"
	description="Real AI agents Prospry has built for clients — the problems, what we built, and the results."
>
	<main id="top">
		<section class="hero">
			<div class="wrap hero-inner">
				<p class="eyebrow">Our work</p>
				<h1>Real problems, real agents, real results.</h1>
				<p class="lede">
					Here's what we've actually built — the problem each business
					walked in with, what we built to solve it, and what changed
					afterward.
				</p>
			</div>
		</section>

		<section class="in-progress">
			<div class="wrap">
				<h2>Case studies</h2>
				<p class="section-lede">See what an AI agent actually does for a business like yours.</p>
				<div class="proof-grid">
					{caseStudies.map((s) => (
						<a class="proof-card" href={`/our-work/${s.slug}`}>
							<span class="industry-tag">{s.industry}</span>
							<span class="card-tag">{s.tag}</span>
							<h3>{s.title}</h3>
							<p class="metric">{s.metric}</p>
							<p>{s.summary}</p>
							{s.quote && (
								<blockquote>
									<p>{s.quote}</p>
									<cite>{s.attribution}</cite>
								</blockquote>
							)}
							<span class="read-more">Read the full case study →</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="cta">
			<div class="wrap cta-inner">
				<h2>Want results like these?</h2>
				<p>
					Book a call and let's talk about what we'd build for your
					business.
				</p>
				<a class="btn btn-primary" href="mailto:hello@prospry.com">Book a call</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		padding: 96px 0 72px;
		background: radial-gradient(circle at 20% 0%, rgba(0, 0, 0, 0.035), transparent 55%);
	}

	.hero-inner {
		max-width: 720px;
	}

	.hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.14;
		margin-bottom: 22px;
	}

	.lede {
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 600px;
	}

	section h2 {
		font-size: 1.8rem;
	}

	.section-lede {
		color: var(--text-muted);
		margin-top: 10px;
		font-size: 1rem;
	}

	.in-progress {
		padding: 72px 0 96px;
	}

	.proof-grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	.proof-card {
		position: relative;
		display: block;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 28px 30px;
		transition: border-color 0.15s ease;
	}

	.proof-card:hover {
		border-color: var(--accent-strong);
	}

	.read-more {
		display: inline-block;
		margin-top: 18px;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent-strong);
	}

	.industry-tag {
		position: absolute;
		top: 20px;
		right: 20px;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 4px 12px;
	}

	.card-tag {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-strong);
		margin-bottom: 10px;
	}

	.proof-card h3 {
		font-size: 1.15rem;
		margin-bottom: 6px;
	}

	.metric {
		font-weight: 700;
		color: var(--accent-strong);
		font-size: 1.02rem;
		margin-bottom: 14px;
	}

	.proof-card > p:not(.metric) {
		color: var(--text-muted);
		font-size: 0.96rem;
	}

	.proof-card blockquote {
		margin: 18px 0 0;
		padding: 14px 18px;
		border-left: 3px solid var(--accent-strong);
		background: var(--bg-alt);
	}

	.proof-card blockquote p {
		color: var(--text);
		font-size: 0.96rem;
		font-style: italic;
		margin-bottom: 6px;
	}

	.proof-card cite {
		font-size: 0.86rem;
		font-style: normal;
		color: var(--text-muted);
	}

	.cta {
		padding: 88px 0;
		text-align: center;
		background: var(--bg-alt);
		border-top: 1px solid var(--border);
	}

	.cta-inner {
		max-width: 600px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.cta h2 {
		font-size: 1.8rem;
	}

	.cta p {
		color: var(--text-muted);
	}

	@media (max-width: 860px) {
		.proof-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
